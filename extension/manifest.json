{
  "manifest_version": 3,
  "name": "Reuniones",
  "version": "0.1.3",
  "description": "Transcribe Google Meet en la carpeta del proyecto, con tu micrófono.",
  "permissions": ["tabCapture", "offscreen", "tabs", "storage", "tts", "scripting"],
  "host_permissions": ["https://meet.google.com/*", "http://127.0.0.1:3939/*"],
  "action": {
    "default_title": "Reuniones",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["worklet.js"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}
